<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.bidarena</groupId>
  <artifactId>bid-arena-core</artifactId>
  <version>0.1.0-SNAPSHOT</version>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <solon.version>3.0.1</solon.version>
    <hikari.version>6.3.3</hikari.version>
    <mysql.version>9.7.0</mysql.version>
    <flyway.version>13.6.0</flyway.version>
    <jjwt.version>0.13.0</jjwt.version>
    <junit.version>5.14.4</junit.version>
    <testcontainers.version>1.21.4</testcontainers.version>
    <archunit.version>1.5.0</archunit.version>
  </properties>

  <dependencies>
    <!-- 运行时容器：HTTP 服务器 + MVC + WebSocket -->
    <dependency>
      <groupId>org.noear</groupId>
      <artifactId>solon-boot-smarthttp</artifactId>
      <version>${solon.version}</version>
    </dependency>
    <dependency>
      <groupId>org.noear</groupId>
      <artifactId>solon-web</artifactId>
      <version>${solon.version}</version>
      <!--
        排除 Solon 自带的 snack3 序列化器。solon-web 默认会带进来一个，
        而它会和下面显式声明的 Jackson 同时注册；两个都在时由插件加载顺序决定谁生效，
        结果是"项目说用 Jackson，实际跑的是 snack3"。snack3 对 @Body 的解析更严格，
        会直接抛 Format error（DEBUG_LOG DBG-11）。这里把只有一个序列化器这件事钉死。
      -->
      <exclusions>
        <exclusion>
          <groupId>org.noear</groupId>
          <artifactId>solon-serialization-snack3</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.noear</groupId>
      <artifactId>solon-boot-websocket</artifactId>
      <version>${solon.version}</version>
    </dependency>

    <!-- 配置 / 序列化 / 日志 -->
    <dependency>
      <groupId>org.noear</groupId>
      <artifactId>solon-serialization-jackson</artifactId>
      <version>${solon.version}</version>
    </dependency>
    <dependency>
      <groupId>org.noear</groupId>
      <artifactId>solon-logging-logback</artifactId>
      <version>${solon.version}</version>
    </dependency>

    <!-- 数据访问：Solon JDBC + 连接池 + MySQL 驱动 -->
    <dependency>
      <groupId>org.noear</groupId>
      <artifactId>solon-data</artifactId>
      <version>${solon.version}</version>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>${hikari.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>${mysql.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- 数据库迁移（应用内自动迁移，见 DECISIONS D-2/D-6） -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <version>${flyway.version}</version>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
      <version>${flyway.version}</version>
    </dependency>

    <!-- 鉴权：JWT + BCrypt -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.mindrot</groupId>
      <artifactId>jbcrypt</artifactId>
      <version>0.4</version>
    </dependency>

    <!-- 测试 -->
    <dependency>
      <groupId>org.noear</groupId>
      <artifactId>solon-test</artifactId>
      <version>${solon.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- 架构规则可测试化：守卫上下文边界与依赖方向（见 DESIGN.md §2.4） -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!--
      迁移脚本放在仓库根目录 db/migration（评审与文档直接可见），
      同时通过 resources 打进 classpath，使 Flyway 以 classpath:db/migration 读取。
      不能用 filesystem: 相对路径：打成 jar / 进容器后该路径不存在。
      声明了 <resources> 就会覆盖 Maven 默认值，所以 src/main/resources 必须显式列出。
    -->
    <resources>
      <resource>
        <directory>db/migration</directory>
        <targetPath>db/migration</targetPath>
        <filtering>false</filtering>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!--
            断言消息含中文。JVM 默认取平台编码（Windows 上常为 GBK），
            会让失败信息在控制台和报告中变成乱码，而测试失败时最需要读的正是这句话。
            固定 UTF-8 后，报告文件在任意平台上都可读；
            控制台若仍乱码，是终端代码页的问题（Windows 下执行 chcp 65001 即可）。
          -->
          <argLine>-Dfile.encoding=UTF-8</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <mainClass>com.bidarena.Application</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
