# Bid Arena 环境变量样例
#
# 用法：
#   cp .env.example .env     # Windows: copy .env.example .env
#   然后修改下面所有 CHANGE_ME 的值；.env 已被 .gitignore 排除，绝不要提交。
#
# docker compose 会自动读取同目录的 .env；
# 直接在本机运行后端时，请把下面的变量导出到当前 shell（见 README 的快速启动）。

# ---------------------------------------------------------------------------
# MySQL 容器
# ---------------------------------------------------------------------------
MYSQL_DATABASE=bid_arena
MYSQL_USER=bid_arena
MYSQL_PASSWORD=CHANGE_ME_db_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
# 宿主机端口。若本机已有 MySQL 占用 3306，改这里即可，不要动容器内的 3306。
MYSQL_PORT=3307

# ---------------------------------------------------------------------------
# 后端服务
# ---------------------------------------------------------------------------
# 面向用户/管理员/前端的 HTTP 端口
SERVER_PORT=8080
# 面向竞拍 Agent 的独立 HTTP 端口（与用户端口分离，见 DECISIONS D-8/D-9）
AGENT_SERVER_PORT=8090

# ---------------------------------------------------------------------------
# 实时事件（WebSocket）
# ---------------------------------------------------------------------------
# 浏览器连的 WS 端口。它与 HTTP 端口**不同**：HTTP 上有鉴权过滤器、封套与 CORS，
# 而 WS 的握手只能带一个查询串，混在同一个监听器上会让两类连接的生命周期互相牵扯。
# 不配时采用 Solon 的默认值「HTTP 端口 + 10000」；显式配出来是为了让部署（含反代）
# 不必去猜这个规则，也让测试能确定地连上去。
WS_PORT=18080
# 一次性入场券的有效期（秒）。为什么要短：票会出现在 URL/日志里，
# 有效期就是「拿到日志的人还能用多久」。默认 60 秒，够一次「取票→连接」的往返。
WS_TICKET_TTL_SECONDS=60
# 同时在库的未核销票数上限。上限存在的意义是内存有硬上界：
# 超过就拒绝签发（429），而不是无界增长直到 OOM。默认 10000。
WS_TICKET_CAPACITY=10000

# ---------------------------------------------------------------------------
# 数据库连接（后端进程读取；容器间互连时把主机名换成 compose 服务名）
# ---------------------------------------------------------------------------
# connectionTimeZone + forceConnectionTimeZoneToSession：把连接会话时区固定为 UTC，
# 使 TIMESTAMP 的读写与 serverTime 的序列化结果不依赖宿主机本地时区。
# allowPublicKeyRetrieval：MySQL 8.4 默认认证插件为 caching_sha2_password，
# 在非 TLS 连接下首次认证需要它，否则会报 "Public Key Retrieval is not allowed"。
#
# 这一行写的是**具体值**（localhost:3307 / bid_arena），不是 `${MYSQL_PORT}` 占位符：
# 它服务于“把变量导出到本机 shell、直接跑后端”这条路（README 开发环境），而 Windows
# PowerShell 的 `$env:DB_URL = "...${MYSQL_PORT}..."` 不会把占位符展开成 3307。
# 改了上面的 MYSQL_PORT 或 MYSQL_DATABASE，这里要同步改。
# （docker compose 下 backend 容器用的是 compose 里写好的 mysql:3306，不受本行影响。）
DB_URL=jdbc:mysql://localhost:3307/bid_arena?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&allowPublicKeyRetrieval=true&useSSL=false&characterEncoding=UTF-8&rewriteBatchedStatements=true
DB_USER=bid_arena
DB_PASSWORD=CHANGE_ME_db_password
# 连接池（可留空使用默认值 16 / 4）
DB_POOL_SIZE=16
DB_POOL_MIN_IDLE=4

# ---------------------------------------------------------------------------
# 到期结算扫描（与上面同一类：留空即用默认值）
# ---------------------------------------------------------------------------
# 每轮间隔毫秒数。扫描器每轮都回数据库查「已到期且仍为 RUNNING」的拍卖，
# 不保存内存状态，所以重启后能够自动接着结算。
SETTLE_SCAN_INTERVAL_MS=1000
# 每轮最多处理多少场。设上限是为了让每轮时长有界，避免积压时一次抱太久。
SETTLE_BATCH_SIZE=50

# ---------------------------------------------------------------------------
# 拍卖规则：尾段"博弈时间"
# ---------------------------------------------------------------------------
# 截止前最后多少秒是只允许真人出价的"博弈时间"，竞拍 Agent 在此期间一律被拒
# （错误码 HUMAN_ONLY_PERIOD，见 DECISIONS D-32）。取 20 是为了把原文"最后 5 秒延时"
# 的狙击窗口整个罩住。留空即用 20。
AUCTION_FINAL_GAME_WINDOW_SECONDS=20

# ---------------------------------------------------------------------------
# 预告开拍扫描（D-35）
# ---------------------------------------------------------------------------
# 每轮间隔毫秒数。扫描器每轮回数据库查「status=DRAFT 且 starts_at <= now」的拍品并开拍。
# 与结算扫描器同构：不保存内存状态，重启/多实例都安全。留空即用 1000。
AUCTION_START_SCAN_INTERVAL_MS=1000
# 每轮最多开拍多少场。
AUCTION_START_BATCH_SIZE=50

# ---------------------------------------------------------------------------
# 托管 AI 代理（D-36）
# ---------------------------------------------------------------------------
# 每轮间隔毫秒数。代理是被「别人加价」驱动的，这个值就是用户感知到的 AI 反应速度：
# 1 秒会觉得迟钝，100ms 则在没有对手的空场上白跑数据库。留空即用 500。
AGENT_PROXY_TICK_INTERVAL_MS=500
# 每轮最多处理多少个活着的代理。
AGENT_PROXY_BATCH_SIZE=50

# ---------------------------------------------------------------------------
# 鉴权与跨域
# ---------------------------------------------------------------------------
# 至少 32 字节的随机串；生成：openssl rand -base64 48
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_bytes
# 允许的前端来源，逗号分隔。
# 单 origin 部署（compose 的 frontend 服务）下浏览器与 API 同源，此项对页面请求已不再必要，
# 但仍建议填上实际访问地址，供本机开发（Vite 5173）或其它跨源调用方使用。
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# 前端容器（compose 的 frontend 服务，单 origin 入口，D-37）
# ---------------------------------------------------------------------------
# 宿主机上浏览器的访问端口。前端容器内是 80，对外只暴露这一个端口：
# `/api` 与 `/ws` 都由它反代到后端容器，18080 不再需要对外。
WEB_PORT=8088
# 构建前端镜像用的基础镜像。网络受限（国内/离线）时可指向本地镜像源，例如：
#   FRONTEND_NODE_IMAGE=<镜像源>/node:22-alpine
#   FRONTEND_NGINX_IMAGE=<镜像源>/nginx:1.27-alpine
# 不配则用 Docker Hub 官方镜像。
FRONTEND_NODE_IMAGE=node:22-alpine
FRONTEND_NGINX_IMAGE=nginx:1.27-alpine

# ---------------------------------------------------------------------------
# 集成测试专用（可选）
# ---------------------------------------------------------------------------
# 只在跑 `mvn clean verify` 时需要，运行后端**不需要**这三个变量，
# 所以可以留在 .env 里当备忘，也可以每次临时 export（见 README 一键验证）。
# 必须指向一个**独立**测试库：库名不能与开发库相同，否则测试会拒绝启动。
# 不想写在这里就注释掉；测试没拿到它们会直接失败，不会退回到开发库。
#BID_ARENA_TEST_DB_URL=jdbc:mysql://localhost:3307/bid_arena_test?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&allowPublicKeyRetrieval=true&useSSL=false&characterEncoding=UTF-8
#BID_ARENA_TEST_DB_USER=bid_arena
#BID_ARENA_TEST_DB_PASSWORD=CHANGE_ME_db_password
